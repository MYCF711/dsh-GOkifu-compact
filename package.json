{
  "name": "dsh-gokifu-compact",
  "version": "1.9.3",
  "description": "DSH context-compression backend with a go game record (kifu) DAG: node = position, edge = attempted move + result. Incremental fold (each span summarized once), failure memory that survives compaction, transposition detection (chess-engine style), and a tiny hot ledger rebuilt every step.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MYCF711/dsh-GOkifu-compact.git"
  },
  "homepage": "https://github.com/MYCF711/dsh-GOkifu-compact#readme",
  "bugs": {
    "url": "https://github.com/MYCF711/dsh-GOkifu-compact/issues"
  },
  "author": "MYCF711 <MYCF711@users.noreply.github.com>",
  "type": "module",
  "main": "src/ui.mjs",
  "exports": {
    ".": {
      "default": "./src/ui.mjs"
    },
    "./engine": "./src/engine.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "!src/.engine-under-test.mjs",
    "!src/.engine-under-test-*.mjs",
    "!src/.harness-stubs",
    "lib",
    "docs",
    "evidence",
    "scripts",
    "CHANGELOG.md",
    "QUICKSTART.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run.mjs",
    "evidence": "node test/evidence.mjs",
    "check:maintenance": "node scripts/check-maintenance.mjs",
    "release": "node scripts/release.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "compaction",
    "context-compression",
    "agent-memory"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction": {
      "optional": false
    },
    "@deepseek-ai/dsh-compaction-basic": {
      "optional": false
    },
    "@deepseek-ai/dsh-llm": {
      "optional": false
    },
    "@deepseek-ai/dsh-session": {
      "optional": false
    },
    "@deepseek-ai/schemastery": {
      "optional": false
    }
  },
  "bin": {
    "dsh-gokifu-compact": "./scripts/cli.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
